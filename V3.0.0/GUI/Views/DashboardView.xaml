<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource HeadingTextStyle}" Text="Dashboard" />
            <TextBlock x:Name="DashSubtitle" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16" />

            <Border x:Name="DashConfigBanner" Style="{StaticResource WarningBannerStyle}" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="DashConfigDetailsButton" DockPanel.Dock="Right" Content="_Details" Margin="12,0,0,0" />
                    <TextBlock x:Name="DashConfigBannerText" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Style="{StaticResource CardStyle}" Width="270" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Active Directory" />
                        <TextBlock x:Name="DashAdState" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="DashAdDetail" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="270" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Offboarding-Warteschlange" />
                        <TextBlock x:Name="DashQueueState" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="DashQueueDetail" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="270" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Vorgänge (30 Tage)" />
                        <TextBlock x:Name="DashStatsState" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="DashStatsDetail" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="270" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Konfiguration" />
                        <TextBlock x:Name="DashConfigState" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="DashConfigDetail" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Schnellzugriff" />
                    <WrapPanel>
                        <Button x:Name="DashNewOnboardingButton" Style="{StaticResource PrimaryButtonStyle}" Content="Neues _Onboarding" Margin="0,0,8,8" />
                        <Button x:Name="DashNewOffboardingButton" Content="O_ffboarding starten" Margin="0,0,8,8" />
                        <Button x:Name="DashBulkButton" Content="_Massenverarbeitung" Margin="0,0,8,8" />
                        <Button x:Name="DashRefreshButton" Content="_Aktualisieren" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Integrationen" />
                    <DataGrid x:Name="DashIntegrationGrid" MaxHeight="280" AutomationProperties.Name="Status der Integrationen">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Integration" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="140" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Hint}" Width="*" />
                            <DataGridTextColumn Header="Umsetzung" Binding="{Binding ImplementationText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Offboarding: fällige Aufgaben" />
                    <DataGrid x:Name="DashQueueGrid" MaxHeight="240" AutomationProperties.Name="Fällige Offboarding-Aufgaben">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="*" />
                            <DataGridTextColumn Header="Vorlage" Binding="{Binding Template}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="160" />
                            <DataGridTextColumn Header="Nächste Phase" Binding="{Binding NextPhaseText}" Width="140" />
                            <DataGridTextColumn Header="Fällig am" Binding="{Binding DueText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Letzte Vorgänge" />
                    <DataGrid x:Name="DashOperationsGrid" MaxHeight="300" AutomationProperties.Name="Letzte Vorgänge">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding TimeText}" Width="150" />
                            <DataGridTextColumn Header="Vorgang" Binding="{Binding Kind}" Width="140" />
                            <DataGridTextColumn Header="Konto" Binding="{Binding Target}" Width="*" />
                            <DataGridTextColumn Header="Ergebnis" Binding="{Binding ResultText}" Width="170" />
                            <DataGridTextColumn Header="Ausgeführt von" Binding="{Binding Actor}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
