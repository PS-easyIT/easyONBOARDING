<!--
    Einstellungen: Konfigurationsdatei, Prüfergebnisse, Darstellung (Farbschema, Akzentfarbe).
    Fachliche Einstellungen werden bewusst in der INI gepflegt (Kommentare bleiben erhalten).
-->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,16">
            <TextBlock Style="{StaticResource HeadingTextStyle}" Text="Einstellungen" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"
                       Text="Fachliche Einstellungen stehen in der INI-Datei. Secrets werden dort ignoriert." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Konfigurationsdatei" />
                    <TextBlock x:Name="SetConfigPathText" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock x:Name="SetConfigSourcesText" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="SetReloadButton" Style="{StaticResource PrimaryButtonStyle}" Content="Neu _laden" Margin="0,0,8,8" />
                        <Button x:Name="SetOpenConfigButton" Content="Im _Editor öffnen" Margin="0,0,8,8" />
                        <Button x:Name="SetCreateConfigButton" Content="Aus _Vorlage erstellen" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Prüfergebnisse der Konfiguration" />
                    <TextBlock x:Name="SetFindingsSummaryText" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />
                    <DataGrid x:Name="SetFindingsGrid" MaxHeight="280" AutomationProperties.Name="Prüfergebnisse der Konfiguration">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Schwere" Binding="{Binding SeverityText}" Width="110" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="190" />
                            <DataGridTextColumn Header="Ort" Binding="{Binding Field}" Width="180" />
                            <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Darstellung" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Farbschema" />
                            <ComboBox x:Name="SetThemeCombo" AutomationProperties.Name="Farbschema" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Akzentfarbe (#RRGGBB)" />
                            <DockPanel>
                                <Border x:Name="SetAccentPreview" DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="4" Margin="8,0,0,0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Background="{DynamicResource AccentBrush}" />
                                <TextBox x:Name="SetAccentText" AutomationProperties.Name="Akzentfarbe" />
                            </DockPanel>
                            <TextBlock x:Name="SetAccentError" Style="{StaticResource FieldErrorStyle}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SetApplyAppearanceButton" Content="_Übernehmen" Margin="0,0,8,8" />
                        <Button x:Name="SetSaveAppearanceButton" Style="{StaticResource PrimaryButtonStyle}" Content="In Konfiguration _speichern" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Speichert nur [UI] Theme und AccentColor, mit Sicherung der INI." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Sicherheit (aus der Konfiguration)" />
                    <TextBlock x:Name="SetSecurityInfoText" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
