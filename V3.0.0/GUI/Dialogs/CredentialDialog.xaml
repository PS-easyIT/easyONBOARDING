<!--
    Einmalige Anzeige von Zugangsdaten nach Kontoanlage oder Kennwort-Reset.
    Das Kennwort wird nur im Arbeitsspeicher gehalten: kein Speichern, kein Protokoll, kein Bericht.
    Kopieren leert die Zwischenablage automatisch; Drucken erfolgt direkt aus dem Speicher.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zugangsdaten (einmalige Anzeige)" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CredCopyButton" Content="Kennwort _kopieren" />
            <Button x:Name="CredPrintButton" Content="_Drucken …" />
            <Button x:Name="CredCloseButton" Style="{StaticResource PrimaryButtonStyle}" Content="_Schließen" IsCancel="True" IsDefault="True" Margin="0" />
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource SubheadingTextStyle}" Text="Zugangsdaten" Margin="0,0,0,4" />
            <Border Style="{StaticResource WarningBannerStyle}">
                <TextBlock Style="{StaticResource BodyTextStyle}"
                           Text="Nur jetzt sichtbar, nirgends gespeichert. Persönlich oder über einen sicheren Kanal übergeben, nie per unverschlüsselter E-Mail." />
            </Border>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CredNameText" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,3" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Anmeldename" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CredUserText" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Anmeldename" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Anmeldung (UPN)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CredUpnText" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Anmeldung UPN" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kennwort" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="CredPasswordText" IsReadOnly="True" Margin="0,6,0,0" FontFamily="Consolas" FontSize="16"
                         AutomationProperties.Name="Kennwort" />
            </Grid>
            <TextBlock x:Name="CredHintText" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
            <TextBlock x:Name="CredClipboardText" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
